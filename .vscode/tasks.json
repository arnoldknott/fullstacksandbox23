{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compose Logs (Auto)",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "logs", "-f"],
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": false,
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}
