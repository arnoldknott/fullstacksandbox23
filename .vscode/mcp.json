{
  "servers": {
    "flyonui-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "flyonui-mcp"]
    },
    "SvelteMCP": {
      "url": "https://mcp.svelte.dev/mcp",
      "type": "http",
      "autoStart": true
    },
    "Context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "autoStart": true
    }
  },
  "inputs": []
}
