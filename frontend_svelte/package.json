{
	"name": "app",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest run",
		"lint": "npx prettier  --plugin=prettier-plugin-svelte --plugin=prettier-plugin-tailwindcss --check . && eslint .",
		"format": "npx prettier --plugin=prettier-plugin-svelte --plugin=prettier-plugin-tailwindcss --write --log-level warn .",
		"imports:sort": "eslint . --fix",
		"clean": "bun imports:sort && bun format && bun lint && bun test:unit && bun check"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.6",
		"@eslint/js": "^10.0.1",
		"@iconify/json": "^2.2.509",
		"@iconify/tailwind4": "^1.2.3",
		"@microsoft/microsoft-graph-types": "^2.43.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/leaflet": "^1.9.22",
		"@types/uuid": "^11.0.0",
		"@types/ws": "^8.18.1",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"@vitest/ui": "^4.1.10",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.9.0",
		"jsdom": "^30.0.1",
		"msw": "^2.15.0",
		"postcss": "^8.5.25",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"rollup-plugin-svelte": "^7.2.3",
		"socket.io": "^4.8.3",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"svelte-preprocess": "^6.0.5",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
