		"@azure/keyvault-secrets": "^4.11.2",
		"@azure/msal-node": "^5.4.3",
		"@material/material-color-utilities": "0.3.0",
		"colorjs.io": "^0.7.1",
		"dompurify": "^3.4.12",
		"dotenv": "^17.4.2",
		"flyonui": "^2.4.1",
		"leaflet": "^1.9.4",
		"marked": "^18.0.7",
		"redis": "^6.2.0",
