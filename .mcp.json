{
	"mcpServers": {
		"flyonui-mcp": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"flyonui-mcp"
			],
			"tools": [
				"*"
			]
		},
		"Context7": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@upstash/context7-mcp@latest"
			],
			"tools": [
				"*"
			]
		},
		"SvelteMCP": {
			"type": "http",
			"url": "https://mcp.svelte.dev/mcp",
			"tools": [
				"*"
			]
		}
	}
}
